<ui:FluentWindow x:Class="WindowsAudioSwitcher.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Windows Audio Switcher"
                 Width="960" Height="700"
                 MinWidth="800" MinHeight="560"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterScreen"
                 Icon="pack://application:,,,/Assets/app.ico">
    <!-- Palette brushes (SurfaceBrush, TextPrimaryBrush, ...) are referenced with
         DynamicResource so a theme switch restyles the open window in place. -->
    <ui:FluentWindow.Resources>

        <!-- Card-row container style for the rule list. Removes ListBoxItem's
             default highlight chrome and replaces with our own elevated card. -->
        <Style x:Key="RuleItemContainerStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="8,3"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <!-- 4-way move arrow advertises that the row is draggable. Interactive
                 children (ToggleSwitch, buttons) override back to Arrow. -->
            <Setter Property="Cursor" Value="SizeAll"/>
            <!-- Screen readers announce the rule and its connection status
                 instead of the item's type name. -->
            <Setter Property="AutomationProperties.Name">
                <Setter.Value>
                    <MultiBinding StringFormat="{}{0}. {1}">
                        <Binding Path="DisplayText"/>
                        <Binding Path="StatusText"/>
                    </MultiBinding>
                </Setter.Value>
            </Setter>
            <Setter Property="AutomationProperties.HelpText" Value="Press Control plus Up or Down arrow to change priority."/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="{DynamicResource SurfaceElevatedBrush}"
                                BorderBrush="{DynamicResource BorderBrushSubtle}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBlueBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBlueBrush}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Single rule row: drag handle | status dot | type chip | display text | toggle | edit | remove. -->
        <DataTemplate x:Key="RuleItemTemplate">
            <Grid MinHeight="36">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="⠿"
                           FontSize="14"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Margin="0,0,10,0"
                           VerticalAlignment="Center"
                           ToolTip="Drag to reorder (or Ctrl+Up / Ctrl+Down)">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Opacity" Value="0.45"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}" Value="True">
                                    <Setter Property="Opacity" Value="1.0"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Connection status: filled green = the rule in use, filled grey =
                     connected but outranked or off, hollow = not connected. -->
                <Ellipse Grid.Column="1"
                         Width="9" Height="9"
                         Margin="0,0,10,0"
                         VerticalAlignment="Center"
                         StrokeThickness="1.5"
                         Cursor="Arrow"
                         ToolTip="{Binding StatusText}">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="Transparent"/>
                            <Setter Property="Stroke" Value="Transparent"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="Active">
                                    <Setter Property="Fill" Value="{DynamicResource StatusGoodBrush}"/>
                                    <Setter Property="Stroke" Value="{DynamicResource StatusGoodBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Connected">
                                    <Setter Property="Fill" Value="{DynamicResource StatusIdleBrush}"/>
                                    <Setter Property="Stroke" Value="{DynamicResource StatusIdleBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="NotConnected">
                                    <Setter Property="Stroke" Value="{DynamicResource StatusIdleBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>

                <Border Grid.Column="2"
                        CornerRadius="9"
                        Padding="9,2"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource AccentBlueBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Kind}" Value="NameContains">
                                    <Setter Property="Background" Value="{DynamicResource AccentPurpleBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                    <Setter Property="Opacity" Value="0.4"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Foreground="White"
                               FontSize="10"
                               FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="EXACT"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Kind}" Value="NameContains">
                                        <Setter Property="Text" Value="NAME MATCH"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
                <TextBlock Grid.Column="3"
                           Text="{Binding DisplayText}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           FontSize="13">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                    <Setter Property="TextDecorations" Value="Strikethrough"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ui:ToggleSwitch Grid.Column="4"
                                 IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalAlignment="Center"
                                 Margin="8,0,4,0"
                                 Cursor="Arrow"
                                 ToolTip="Enable / disable this rule"
                                 AutomationProperties.Name="{Binding DisplayText, StringFormat='Rule enabled: {0}'}"/>
                <ui:Button Grid.Column="5"
                           Appearance="Transparent"
                           Padding="6,2"
                           Margin="2,0,0,0"
                           VerticalAlignment="Center"
                           Cursor="Arrow"
                           Tag="{Binding}"
                           Click="RuleEditBtn_Click"
                           ToolTip="Edit rule"
                           AutomationProperties.Name="{Binding DisplayText, StringFormat='Edit rule {0}'}">
                    <TextBlock Text="✎"
                               FontSize="13"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                </ui:Button>
                <ui:Button Grid.Column="6"
                           Appearance="Transparent"
                           Padding="6,2"
                           Margin="2,0,0,0"
                           VerticalAlignment="Center"
                           Cursor="Arrow"
                           Tag="{Binding}"
                           Click="RuleRemoveBtn_Click"
                           ToolTip="Remove rule"
                           AutomationProperties.Name="{Binding DisplayText, StringFormat='Remove rule {0}'}">
                    <TextBlock Text="✕"
                               FontSize="13"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                </ui:Button>
            </Grid>
        </DataTemplate>

        <!-- Reusable card chrome for the two column panes and the two header tiles. -->
        <Style x:Key="SurfaceCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>

        <!-- Banner chrome shared by the update and pause notices. -->
        <Style x:Key="BannerStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="20,8,20,0"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- WPF UI 4's TitleBar.Header occupies the title slot on the left, so the
             title and the dimmed version label live there together. Both are laid
             out by the panel, so the version follows the title's real width at any
             font scaling instead of sitting at a hard-coded offset. -->
        <ui:TitleBar Grid.Row="0"
                     x:Name="AppTitleBar"
                     Title="Windows Audio Switcher"
                     ShowMaximize="True">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app.ico"/>
            </ui:TitleBar.Icon>
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False">
                    <TextBlock Text="Windows Audio Switcher"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="AppTitleBarVersion"
                               VerticalAlignment="Center"
                               Margin="6,0,0,0"
                               FontSize="12"
                               Opacity="0.6"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- Update-available banner. Collapsed until UpdateChecker finds a newer release.
             Two visual states: idle (Update / Dismiss) and downloading (progress + Cancel). -->
        <Border x:Name="UpdateBanner"
                Grid.Row="1"
                Style="{StaticResource BannerStyle}"
                BorderBrush="{DynamicResource AccentBlueBrush}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Background="{DynamicResource AccentBlueBrush}"
                            CornerRadius="4"
                            Width="28" Height="28"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="↓"
                                   Foreground="White"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="UpdateBannerTitle"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Text="Update available"/>
                        <TextBlock x:Name="UpdateBannerMessage"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="11"
                                   Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <ui:Button Grid.Column="2"
                               x:Name="UpdateInstallBtn"
                               Content="Update"
                               Appearance="Primary"
                               Padding="14,4"
                               Margin="0,0,6,0"
                               Click="UpdateInstallBtn_Click"/>
                    <ui:Button Grid.Column="3"
                               x:Name="UpdateCancelBtn"
                               Content="Cancel"
                               Appearance="Secondary"
                               Padding="14,4"
                               Margin="0,0,6,0"
                               Visibility="Collapsed"
                               Click="UpdateCancelBtn_Click"/>
                    <ui:Button Grid.Column="4"
                               x:Name="UpdateDismissBtn"
                               Appearance="Transparent"
                               Padding="6,2"
                               Click="UpdateDismissBtn_Click"
                               ToolTip="Dismiss for now"
                               AutomationProperties.Name="Dismiss update notice">
                        <TextBlock Text="✕"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                    </ui:Button>
                </Grid>
                <ProgressBar x:Name="UpdateProgressBar"
                             Minimum="0"
                             Maximum="100"
                             Height="4"
                             Margin="0,10,0,0"
                             Visibility="Collapsed"
                             Background="{DynamicResource BorderBrushSubtle}"
                             Foreground="{DynamicResource AccentBlueBrush}"
                             BorderThickness="0"
                             AutomationProperties.Name="Update download progress"/>
            </StackPanel>
        </Border>

        <!-- Paused banner. Visible while automatic switching is paused from the tray. -->
        <Border x:Name="PauseBanner"
                Grid.Row="2"
                Style="{StaticResource BannerStyle}"
                BorderBrush="{DynamicResource StatusWarnBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        Background="{DynamicResource StatusWarnBrush}"
                        CornerRadius="4"
                        Width="28" Height="28"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center">
                    <TextBlock Text="❚❚"
                               Foreground="White"
                               FontSize="11"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="PauseBannerTitle"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Text="Automatic switching is paused"/>
                    <TextBlock Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="11"
                               Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis"
                               Text="Device changes won't switch anything. Apply now still works."/>
                </StackPanel>
                <ui:Button Grid.Column="2"
                           x:Name="ResumeBtn"
                           Content="Resume"
                           Appearance="Secondary"
                           Padding="14,4"
                           Click="ResumeBtn_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="20,4,20,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Currently routing header (two tiles) -->
            <Grid Grid.Row="0" Margin="0,4,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource SurfaceCardStyle}" Padding="16,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse Grid.Column="0"
                                 Width="10" Height="10"
                                 Fill="{DynamicResource StatusGoodBrush}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,14,0"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="OUTPUT"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock x:Name="OutCurrentText"
                                       Text="(checking…)"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource SurfaceCardStyle}" Padding="16,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse Grid.Column="0"
                                 Width="10" Height="10"
                                 Fill="{DynamicResource StatusGoodBrush}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,14,0"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="INPUT"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock x:Name="InCurrentText"
                                       Text="(checking…)"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Section heading -->
            <StackPanel Grid.Row="1" Margin="0,0,0,12">
                <TextBlock Text="Priority rules"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="The first enabled rule whose device is connected wins (green dot). Drag rows, or select one and press Ctrl+↑ / Ctrl+↓, to reorder. Toggle off to disable without removing."
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,2,0,0"
                           Foreground="{DynamicResource TextMutedBrush}"/>
            </StackPanel>

            <!-- Two-column rule panes -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Output column -->
                <Border Grid.Column="0" Style="{StaticResource SurfaceCardStyle}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top"
                                Padding="16,12,16,10">
                            <TextBlock Text="Output (speakers / headphones)"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Border>
                        <Border DockPanel.Dock="Bottom" Padding="12,8,12,12">
                            <ui:Button x:Name="OutAddBtn"
                                       Content="+ Add device"
                                       Appearance="Secondary"
                                       HorizontalAlignment="Stretch"
                                       HorizontalContentAlignment="Center"
                                       AutomationProperties.Name="Add output rule"
                                       Click="OutAddBtn_Click"/>
                        </Border>
                        <Grid>
                            <ListBox x:Name="OutList"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ItemTemplate="{StaticResource RuleItemTemplate}"
                                     ItemContainerStyle="{StaticResource RuleItemContainerStyle}"
                                     AllowDrop="True"
                                     AutomationProperties.Name="Output priority rules"
                                     PreviewMouseLeftButtonDown="RulesListBox_PreviewMouseLeftButtonDown"
                                     PreviewMouseMove="RulesListBox_PreviewMouseMove"
                                     PreviewKeyDown="RulesListBox_PreviewKeyDown"
                                     DragOver="RulesListBox_DragOver"
                                     Drop="RulesListBox_Drop"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                            <TextBlock x:Name="OutEmptyText"
                                       Text="No rules yet.&#10;Click + Add device to get started."
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="12"
                                       IsHitTestVisible="False"
                                       Visibility="Collapsed"/>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- Input column -->
                <Border Grid.Column="2" Style="{StaticResource SurfaceCardStyle}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top"
                                Padding="16,12,16,10">
                            <TextBlock Text="Input (microphones)"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Border>
                        <Border DockPanel.Dock="Bottom" Padding="12,8,12,12">
                            <ui:Button x:Name="InAddBtn"
                                       Content="+ Add device"
                                       Appearance="Secondary"
                                       HorizontalAlignment="Stretch"
                                       HorizontalContentAlignment="Center"
                                       AutomationProperties.Name="Add input rule"
                                       Click="InAddBtn_Click"/>
                        </Border>
                        <Grid>
                            <ListBox x:Name="InList"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ItemTemplate="{StaticResource RuleItemTemplate}"
                                     ItemContainerStyle="{StaticResource RuleItemContainerStyle}"
                                     AllowDrop="True"
                                     AutomationProperties.Name="Input priority rules"
                                     PreviewMouseLeftButtonDown="RulesListBox_PreviewMouseLeftButtonDown"
                                     PreviewMouseMove="RulesListBox_PreviewMouseMove"
                                     PreviewKeyDown="RulesListBox_PreviewKeyDown"
                                     DragOver="RulesListBox_DragOver"
                                     Drop="RulesListBox_Drop"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                            <TextBlock x:Name="InEmptyText"
                                       Text="No rules yet.&#10;Click + Add device to get started."
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="12"
                                       IsHitTestVisible="False"
                                       Visibility="Collapsed"/>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- InfoBar: surfaces on save / apply / error. Otherwise collapsed. -->
            <ui:InfoBar Grid.Row="3"
                        x:Name="StatusInfoBar"
                        Margin="0,14,0,0"
                        IsClosable="True"
                        IsOpen="False"
                        Severity="Informational"/>

            <!-- Settings strip: options wrap onto a second line in narrow windows. -->
            <Grid Grid.Row="4" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                    <ui:ToggleSwitch x:Name="RunOnStartupCheck"
                                     Content="Run on Windows startup"
                                     Margin="0,4,24,4"
                                     VerticalAlignment="Center"
                                     Checked="SettingsToggle_Changed"
                                     Unchecked="SettingsToggle_Changed"/>
                    <ui:ToggleSwitch x:Name="StartMinimizedCheck"
                                     Content="Start minimized to tray"
                                     Margin="0,4,24,4"
                                     VerticalAlignment="Center"
                                     Checked="SettingsToggle_Changed"
                                     Unchecked="SettingsToggle_Changed"/>
                    <ui:ToggleSwitch x:Name="SwitchCommsCheck"
                                     Content="Switch communications device too"
                                     Margin="0,4,24,4"
                                     VerticalAlignment="Center"
                                     ToolTip="Also move the Communications role used by Teams, Discord and Zoom. Turn off to keep a separate headset for calls."
                                     Checked="SettingsToggle_Changed"
                                     Unchecked="SettingsToggle_Changed"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,24,4" VerticalAlignment="Center">
                        <TextBlock Text="Theme"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <ComboBox x:Name="ThemeCombo"
                                  MinWidth="150"
                                  AutomationProperties.Name="Theme"
                                  SelectionChanged="ThemeCombo_SelectionChanged">
                            <ComboBoxItem Content="Dark" Tag="Dark"/>
                            <ComboBoxItem Content="Light" Tag="Light"/>
                            <ComboBoxItem Content="Match Windows" Tag="System"/>
                        </ComboBox>
                    </StackPanel>
                </WrapPanel>
                <ui:Button Grid.Column="1"
                           x:Name="ApplyNowBtn"
                           Content="Apply now"
                           Appearance="Secondary"
                           Padding="16,6"
                           VerticalAlignment="Bottom"
                           ToolTip="Re-run the rules now (works even while paused)"
                           Click="ApplyNowBtn_Click"/>
                <ui:Button Grid.Column="2"
                           Content="Close"
                           Appearance="Transparent"
                           Margin="8,0,0,0"
                           Padding="16,6"
                           VerticalAlignment="Bottom"
                           Click="CloseBtn_Click"/>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
